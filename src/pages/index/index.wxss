.page{max-width:900rpx;margin:0 auto;padding:40rpx 36rpx 170rpx}.masthead,.heading,.date-row,.section-label,.toolbar,.card-top,.card-foot,.source-toggle,.primary-actions,.secondary-actions{display:flex;align-items:center;justify-content:space-between}.masthead{font-size:20rpx;color:#686b5e;letter-spacing:4rpx}.edition{letter-spacing:1rpx}.heading{margin-top:40rpx}.title{font-family:"Songti SC","Noto Serif CJK SC",serif;font-size:76rpx;letter-spacing:4rpx;font-weight:600}.dot{color:#a94334}.subtitle{margin-top:14rpx;color:#727367;font-size:26rpx}.seal{border:2rpx solid #a94334;color:#a94334;transform:rotate(5deg);padding:8rpx;font-family:serif;font-size:23rpx;line-height:1.35;letter-spacing:4rpx}.date-row{border-top:1rpx solid #d8d2c4;border-bottom:1rpx solid #d8d2c4;margin-top:36rpx;padding:18rpx 0;color:#737366;font-size:22rpx}.section-label{color:#727367;font-size:21rpx;margin:34rpx 0 18rpx;letter-spacing:1rpx}.section-hint{font-size:20rpx;letter-spacing:0}.scene-scroll{width:100%;white-space:nowrap}.scenes{display:flex;gap:14rpx;padding-bottom:8rpx}.scene{flex:none;white-space:normal;min-width:185rpx;text-align:left;border:1rpx solid #d9d3c7;padding:20rpx;border-radius:8rpx;color:#454b40;background:#f8f5ed;font-size:26rpx}.scene-hint{display:block;font-size:19rpx;color:#808072;margin-top:8rpx}.scene.selected{background:#374e43;color:#fff;border-color:#374e43}.scene.selected .scene-hint{color:#ccd8cf}.toolbar{margin:26rpx 0 18rpx}.tones,.target,.lengths,.calendar-tabs{display:flex;gap:8rpx;flex-wrap:wrap}.target{margin-top:16rpx}.chip{font-size:23rpx;padding:10rpx 15rpx;border-radius:5rpx;color:#77796b;min-height:48rpx}.chip.active{background:#e6e4d7;color:#344d40}.quiet{color:#75776b;font-size:22rpx;padding:10rpx 0;min-height:48rpx}.toast-card{position:relative;padding:26rpx 30rpx 24rpx;background:#fffdf7;border:1rpx solid #dfd8c9;border-radius:8rpx;box-shadow:0 8rpx 30rpx #44392408}.card-kicker{font-size:20rpx;color:#939080;letter-spacing:2rpx}.toast-title{font-size:28rpx;color:#45594b;font-weight:500;margin-top:22rpx;letter-spacing:2rpx}.quote-mark{font-family:Georgia,serif;color:#cbb38b;font-size:86rpx;height:54rpx;margin-top:6rpx}.speech{font-family:"Songti SC","Noto Serif CJK SC",serif;font-size:36rpx;line-height:1.95;letter-spacing:1rpx;overflow-wrap:break-word;word-break:normal}.speech-line+.speech-line{margin-top:18rpx}.big .speech{font-size:48rpx}.translation{color:#76786c;font-size:26rpx;line-height:1.8;border-top:1rpx dashed #ddd6c7;margin-top:20rpx;padding-top:16rpx}.card-foot{border-top:1rpx solid #e7e1d5;margin-top:28rpx;padding-top:14rpx;color:#92907f;font-size:19rpx}.card-foot .chip{font-size:21rpx;padding:8rpx 12rpx}.primary-actions{gap:16rpx;margin-top:22rpx}.primary{background:#a94334;color:#fff;border-radius:7rpx;padding:25rpx 28rpx;text-align:left;flex:1;font-size:30rpx;display:flex;justify-content:space-between;align-items:center}.next-arrow{font-size:34rpx}.save{border:1rpx solid #c9c7b7;border-radius:7rpx;padding:27rpx 25rpx;color:#4d5d4b;font-size:26rpx;min-width:192rpx}.save.saved{background:#e4e8dc}.secondary-actions{justify-content:center;gap:75rpx;margin:14rpx 0}.secondary-button{font-size:23rpx;color:#727667;padding:20rpx}.notice{background:#e9e8db;color:#4c604f;font-size:23rpx;line-height:1.6;padding:16rpx 20rpx;margin-top:16rpx;border-radius:5rpx}.source{border-top:1rpx solid #d8d2c4;border-bottom:1rpx solid #d8d2c4}.source-toggle{width:100%;text-align:left;padding:25rpx 0;color:#707466}.source-label{font-size:26rpx;color:#394f42;margin-bottom:8rpx}.source-subtitle{font-size:21rpx}.source-symbol{font-size:34rpx}.source-body{font-size:26rpx;color:#606957;line-height:1.9;padding:0 0 25rpx}.original{font-family:serif;font-size:30rpx;color:#a94334;margin-bottom:14rpx}.tip{margin-top:18rpx}.reference{font-size:21rpx;color:#868476;line-height:1.8;margin-top:14rpx}.link{font-size:22rpx;color:#8d4838;text-align:left;padding:12rpx 0}.calendar-tabs{margin-bottom:14rpx}.footer{margin-top:54rpx;text-align:center;color:#8a8778;font-family:serif;font-size:24rpx}.footer-button{font-family:sans-serif;font-size:21rpx;color:#7f8472;padding:20rpx}.bottom-nav{position:fixed;bottom:0;left:0;right:0;display:flex;justify-content:center;background:#f7f3ebeF;border-top:1rpx solid #dcd7c9;padding:12rpx 0 calc(12rpx + env(safe-area-inset-bottom));z-index:5}.bottom-nav .nav-button{width:40%;padding:20rpx;color:#8a8b7a;font-size:26rpx}.bottom-nav .current{color:#9c4434;font-weight:600}.empty{text-align:center;padding:80rpx 0;color:#58634e;font-size:36rpx;font-family:serif}.empty-hint{display:block;font-size:24rpx;color:#8c8b7c;margin-top:22rpx}.empty .primary{margin-top:50rpx;display:block;text-align:center}.favorite-card{background:#fffdf7;border:1rpx solid #ded8ca;border-radius:7rpx;padding:10rpx 24rpx 16rpx;margin:24rpx 0}.favorite-open{text-align:left;width:100%;padding:0}.excerpt{font-family:serif;font-size:28rpx;line-height:1.8;margin-top:18rpx;color:#5c6554;white-space:pre-line}.remove{text-align:right;width:100%;font-size:22rpx;margin-top:14rpx}
/* WeChat v2 buttons default to full width; chips must size to their labels. */
.chip,.quiet,.scene{width:auto;flex:0 0 auto}.tones{flex-wrap:nowrap}.toolbar{gap:12rpx}.primary-actions .primary{width:auto;min-width:0}.save{width:auto;flex:0 0 auto}.source-toggle,.favorite-open{width:100%}.secondary-button,.footer-button{width:auto}
.chip,.quiet,.primary,.save,.scene{min-width:0;font-weight:400}
.tones .chip{width:82rpx;min-width:0;padding:10rpx 8rpx;flex:0 0 82rpx}
.tones .english-chip{width:112rpx;flex-basis:112rpx}
.scene{width:185rpx;flex:0 0 185rpx}
.save{width:192rpx;flex:0 0 192rpx}
.quiet{max-width:150rpx}.source-toggle{max-width:none}

.tap-hover{opacity:.78}.scene{line-height:1.4}.chip{line-height:1.4}.quiet{line-height:1.4;white-space:nowrap}.primary,.save{line-height:1.4}.save{text-align:center}.scene-hint{display:block}.footer-button,.secondary-button{text-align:center}.nav-button{text-align:center}.primary-actions .primary{min-height:88rpx}

.speech-line{display:block}.secondary-label{font-size:23rpx;font-weight:400;color:#727667;line-height:1.4}.footer-label{font-size:21rpx;font-weight:400;color:#7f8472;line-height:1.4}

/* Style choices wrap on small phones instead of squeezing the tea control. */
.toolbar{align-items:center;flex-direction:row;flex-wrap:wrap;gap:8rpx}.tones{flex-wrap:wrap;gap:4rpx}.tones .chip,.tones .english-chip{width:auto;flex:0 0 auto;padding:10rpx 10rpx}.toolbar>.quiet{align-self:center;margin-left:auto}

.poetry-topics{margin:8rpx 0 24rpx;padding:16rpx 0;border-top:1rpx dashed #d8d2c4}.topic-label{font-size:21rpx;color:#797866;display:block;margin-bottom:8rpx}.poetry-topics .tones{flex-wrap:wrap}.poetry-topics .chip{font-size:22rpx;padding:8rpx 12rpx}
