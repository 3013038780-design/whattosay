<view class="page">
 <view class="masthead"><text>席 间 有 话</text><text class="edition">试读版 0.2.1 · {{calendar.season}}日小笺</text></view>
 <view class="heading"><view><view class="title">轮到我了<text class="dot">。</text></view><view class="subtitle">一杯有心意，一席有好词。</view></view><view class="seal">好好<view>说话</view></view></view>
 <view class="date-row"><text>{{calendar.date}} · {{calendar.lunar}}</text><text>{{calendar.term}}{{calendar.termDay ? ' · 今日交节' : '时节'}}</text></view>
 <block wx:if="{{tab === 'home'}}">
  <view class="section-label"><text>01 / 这一席，和谁说</text><text class="section-hint">选好场景，直接开口</text></view>
  <scroll-view scroll-x class="scene-scroll"><view class="scenes"><view aria-role="button" hover-class="tap-hover" wx:for="{{sceneOptions}}" wx:key="id" class="scene {{choice.scene === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="scene"><view>{{item.name}}</view><text class="scene-hint">{{item.hint}}</text></view></view></scroll-view>
  <view class="target" wx:if="{{choice.scene === 'work'}}"><view aria-role="button" hover-class="tap-hover" class="chip {{choice.target === 'table' ? 'active' : ''}}" data-id="table" bindtap="target">敬全桌</view><view aria-role="button" hover-class="tap-hover" class="chip {{choice.target === 'leader' ? 'active' : ''}}" data-id="leader" bindtap="target">单独敬领导</view></view>
  <view class="target" wx:if="{{choice.scene === 'family'}}"><view aria-role="button" hover-class="tap-hover" class="chip {{choice.target === 'table' ? 'active' : ''}}" data-id="table" bindtap="target">敬全家</view><view aria-role="button" hover-class="tap-hover" class="chip {{choice.target === 'elder' ? 'active' : ''}}" data-id="elder" bindtap="target">敬长辈</view></view><view class="target" wx:if="{{choice.scene === 'thanks'}}"><view aria-role="button" hover-class="tap-hover" class="chip {{choice.target === 'table' ? 'active' : ''}}" data-id="table" bindtap="target">感谢好意</view><view aria-role="button" hover-class="tap-hover" class="chip {{choice.target === 'host' ? 'active' : ''}}" data-id="host" bindtap="target">谢主人款待</view></view><view class="toolbar"><view class="tones"><view aria-role="button" hover-class="tap-hover" class="chip {{choice.tone === 'auto' ? 'active' : ''}}" data-id="auto" bindtap="tone">随场挑</view><view aria-role="button" hover-class="tap-hover" class="chip {{choice.tone === 'poetic' ? 'active' : ''}}" data-id="poetic" bindtap="tone">顺口祝愿</view><view aria-role="button" hover-class="tap-hover" class="chip {{choice.tone === 'verse' ? 'active' : ''}}" data-id="verse" bindtap="tone">诗词雅意</view><view aria-role="button" hover-class="tap-hover" class="chip {{choice.tone === 'fun' ? 'active' : ''}}" data-id="fun" bindtap="tone">诙谐妙语</view><view aria-role="button" hover-class="tap-hover" class="chip english-chip {{choice.tone === 'english' ? 'active' : ''}}" data-id="english" bindtap="tone">English</view></view><view aria-role="button" hover-class="tap-hover" class="quiet" bindtap="tea">{{choice.tea ? '✓ 以茶代酒' : '以茶代酒'}}</view></view>
  <view class="toast-card {{big ? 'big' : ''}}"><view class="card-top"><text class="card-kicker">02 / 就说这一句</text><view aria-role="button" hover-class="tap-hover" class="quiet" bindtap="big">{{big ? '收起大字' : '大字读'}}</view></view><view class="toast-title">{{toast.title}}</view><view class="quote-mark">“</view><view class="speech"><text class="speech-line" user-select="{{true}}" wx:for="{{lines}}" wx:key="*this">{{item}}</text></view><view class="translation" wx:if="{{choice.tone === 'english'}}">{{translation}}</view><view class="card-foot"><text>{{kind}}</text><view class="lengths" wx:if="{{choice.tone !== 'english'}}"><view aria-role="button" hover-class="tap-hover" class="chip {{choice.length === 'short' ? 'active' : ''}}" data-id="short" bindtap="length">一句版</view><view aria-role="button" hover-class="tap-hover" class="chip {{choice.length === 'full' ? 'active' : ''}}" data-id="full" bindtap="length">短段版</view></view></view></view>
  <view class="primary-actions"><view aria-role="button" hover-class="tap-hover" class="primary" bindtap="next">换一句 <text class="next-arrow">↗</text></view><view aria-role="button" hover-class="tap-hover" class="save {{isSaved ? 'saved' : ''}}" bindtap="save">{{isSaved ? '已收藏' : '收进小笺'}}</view></view>
  <view class="notice" role="status" wx:if="{{notice}}">{{notice}}</view>
  <view class="secondary-actions"><view aria-role="button" hover-class="tap-hover" class="secondary-button" bindtap="copy">复制这句</view><button size="mini" class="secondary-button" open-type="share"><text class="secondary-label">分享这句</text></button></view>
  <view class="source"><view aria-role="button" hover-class="tap-hover" class="source-toggle" bindtap="details"><view><view class="source-label">这一句，有来头</view><text class="source-subtitle">{{source.title}}</text></view><text class="source-symbol">{{details ? '－' : '＋'}}</text></view><view class="source-body" wx:if="{{details}}"><view class="original" wx:if="{{source.original}}">{{source.original}}</view><view>{{source.meaning}}</view><view class="tip">怎么说 · {{toast.tip}}</view><view class="reference">{{source.book}} · {{source.pages}}</view><view class="reference">{{source.note}}</view><view aria-role="button" hover-class="tap-hover" class="link" bindtap="copySource">复制出处</view></view></view>
  <view class="calendar-box"><view class="section-label"><text>03 / 借一点时令入题</text><picker mode="date" value="{{choice.date}}" start="2000-01-01" end="2099-12-31" bindchange="date"><text class="link">换个日期 ↗</text></picker></view><view class="calendar-tabs"><view aria-role="button" hover-class="tap-hover" class="chip {{choice.calendarMode === 'none' ? 'active' : ''}}" data-id="none" bindtap="calendarMode">先不加</view><view aria-role="button" hover-class="tap-hover" class="chip {{choice.calendarMode === 'day' ? 'active' : ''}}" data-id="day" bindtap="calendarMode">{{calendar.day}}号 · {{calendar.theme}}</view><view aria-role="button" hover-class="tap-hover" class="chip {{choice.calendarMode === 'season' ? 'active' : ''}}" data-id="season" bindtap="calendarMode">四季</view><view aria-role="button" hover-class="tap-hover" class="chip {{choice.calendarMode === 'term' ? 'active' : ''}}" data-id="term" bindtap="calendarMode">{{calendar.term}}</view></view><view class="reference">{{choice.tone === 'english' ? '英文时令祝愿与正文一同呈现。' : '日期与节气提供意象，不预设此刻的天气。'}}</view></view>
 </block>
 <view wx:else class="favorites"><view class="section-label">我的小笺 / {{favorites.length}} 张</view><view wx:if="{{!favorites.length}}" class="empty"><view>留一句，待下次。</view><text class="empty-hint">遇到合心意的话，点“收进小笺”。</text><view aria-role="button" hover-class="tap-hover" class="primary" data-id="home" bindtap="tab">去找一句好词</view></view><view wx:for="{{favorites}}" wx:key="query" class="favorite-card"><view aria-role="button" hover-class="tap-hover" class="favorite-open" data-query="{{item.query}}" bindtap="openSaved"><view class="toast-title">{{item.title}}</view><view class="reference">{{item.scene}}</view><view class="excerpt">{{item.excerpt}}</view></view><view aria-role="button" hover-class="tap-hover" class="quiet remove" data-query="{{item.query}}" bindtap="removeSaved">移除</view></view><view class="notice" wx:if="{{notice}}">{{notice}}</view><view class="reference">收藏保存在这台设备。最多保留100张。</view></view>
 <view class="footer"><text>读诗知意，说话知人。</text><view aria-role="button" hover-class="tap-hover" class="footer-button" bindtap="about">关于小笺与数据说明</view><button size="mini" class="footer-button" open-type="share" data-home="true"><text class="footer-label">把小程序分享给朋友 ↗</text></button></view>
</view>
<view class="bottom-nav"><view aria-role="button" hover-class="tap-hover" class="nav-button {{tab === 'home' ? 'current' : ''}}" data-id="home" bindtap="tab">席间找词</view><view aria-role="button" hover-class="tap-hover" class="nav-button {{tab === 'saved' ? 'current' : ''}}" data-id="saved" bindtap="tab">我的小笺</view></view>
