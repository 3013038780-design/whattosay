<view class="page">
 <view class="masthead"><text>席 间 有 话</text><text class="edition">试读版 0.6.2 · {{calendar.season}}日小笺</text></view>
 <view class="heading"><view><view class="title">轮到我了<text class="dot">。</text></view><view class="subtitle">一杯有心意，一席有好词。</view></view><view class="seal">好好<view>说话</view></view></view>
 <view class="date-row"><text>{{calendar.date}} · {{calendar.lunar}}{{calendar.festivalName ? ' · ' + calendar.festivalName : ''}}</text><text>{{calendar.term}}{{calendar.termDay ? ' · 今日交节' : '时节'}}</text></view>
 <view wx:if="{{editor}}" class="draft-editor">
  <view class="section-label">把话写成自己的</view><view class="reference">保存为个人小笺，不改动素材原文。仅留在本机。</view>
  <view class="edit-label">标题</view><input class="edit-input" aria-label="小笺标题" value="{{editor.title}}" maxlength="40" data-field="title" bindinput="editorField" placeholder="给这句话起个名字" />
  <view class="edit-label">场景 · 可以自己起名</view><input class="edit-input" aria-label="自定义场景" value="{{editor.scene}}" maxlength="40" data-field="scene" bindinput="editorField" placeholder="例如：同学十年聚会、爸爸生日" />
  <view class="edit-label">说给谁</view><input class="edit-input" aria-label="说话对象" value="{{editor.target}}" maxlength="40" data-field="target" bindinput="editorField" placeholder="例如：老同学、家人、陈老师" />
  <view class="edit-label">正文 · {{editor.text.length}} / 2000</view><textarea class="edit-text" aria-label="小笺正文" value="{{editor.text}}" maxlength="2000" data-field="text" bindinput="editorField" placeholder="把想说的话，慢慢写下来。" auto-height="{{true}}" />
  <view class="reference" wx:if="{{editor.reference}}">保留原稿出处作参考；个人改写不等于古人原话。</view>
  <view class="notice" wx:if="{{notice}}">{{notice}}</view><view class="primary-actions"><view aria-role="button" class="primary" bindtap="saveDraft">保存我的小笺</view><view aria-role="button" class="save" bindtap="cancelDraft">取消</view></view>
 </view>
 <view wx:elif="{{personal}}" class="personal-reader">
  <view class="section-label">我写的 / 个人改写</view><view class="reference">{{personal.scene || '未分类'}} · {{personal.target || '对象未填写'}}</view>
  <view class="toast-card {{big ? 'big' : ''}}"><view class="card-top"><view class="toast-title">{{personal.title}}</view><view aria-role="button" class="quiet" bindtap="big">{{big ? '收起大字' : '大字读'}}</view></view><view class="speech"><text class="speech-line" user-select="{{true}}" wx:for="{{personalLines}}" wx:key="index">{{item}}</text></view></view>
  <view class="secondary-actions"><view aria-role="button" class="secondary-button" bindtap="copyPersonal">复制我的话</view><view aria-role="button" class="secondary-button" data-id="{{personal.id}}" bindtap="editDraft">继续编辑</view></view>
  <view wx:if="{{personalSource}}" class="source"><view class="source-label">原稿出处 · 仅供参考</view><view>{{personalSource.fullOriginalTitle || personalSource.title}}</view><text class="full-original-text" user-select="{{true}}">{{personalSource.fullOriginal || personalSource.original}}</text><view class="reference">{{personalSource.meaning}}</view><view class="reference">{{personalSource.book}} · {{personalSource.pages}}</view></view>
  <view class="notice" wx:if="{{notice}}">{{notice}}</view><view aria-role="button" class="link" bindtap="closePersonal">返回我的小笺</view>
 </view>
 <block wx:elif="{{tab === 'home'}}">
  <view class="selector-section"><view class="selector-head"><text class="selector-label">这是什么局？</text><view aria-role="button" class="quick-link" bindtap="quick">直接来一句 ↗</view></view><view class="choice-grid"><view aria-role="button" hover-class="tap-hover" wx:for="{{occasionOptions}}" wx:key="id" class="choice-chip {{uiOccasion === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="occasion">{{item.name}}</view></view></view>
  <view class="selector-section"><view class="selector-label">现在要说什么？</view><view class="choice-grid purpose-grid"><view aria-role="button" hover-class="tap-hover" wx:for="{{purposeOptions}}" wx:key="id" class="choice-chip {{uiPurpose === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="purpose">{{item.name}}</view></view></view>
  <view wx:if="{{targetOptions.length}}" class="target"><text class="selector-label">说给谁</text><view aria-role="button" hover-class="tap-hover" wx:for="{{targetOptions}}" wx:key="id" class="chip {{choice.target === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="target">{{item.name}}</view></view>
  <view aria-role="button" class="expression-entry" bindtap="toggleExpression"><text>调整表达</text><text class="expression-current">{{expressionLabel}} ⌄</text></view>
  <view class="expression-options"><view aria-role="button" class="options-toggle" bindtap="toggleOptions"><view><text class="source-label">时令与意境</text><text class="options-summary">日期、节气与入题意象</text></view><text class="source-symbol">{{optionsOpen ? '－' : '＋'}}</text></view>
  <view wx:if="{{optionsOpen}}" class="options-body">
   <view class="selector-label">借什么入题？</view><view class="tones"><view aria-role="button" wx:for="{{imageryOptions}}" wx:key="id" class="chip {{choice.topic === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="topic">{{item.name}}</view></view>
  <view class="calendar-box"><view class="section-label"><text>添一点时令</text><picker mode="date" value="{{choice.date}}" start="2000-01-01" end="2099-12-31" bindchange="date"><text class="link">换个日期 ↗</text></picker></view><view class="calendar-tabs"><view aria-role="button" hover-class="tap-hover" wx:if="{{calendar.festivalName}}" class="chip {{choice.calendarMode === 'festival' ? 'active' : ''}}" data-id="festival" bindtap="calendarMode">{{calendar.festivalName}} · 团聚心意</view><view aria-role="button" hover-class="tap-hover" class="chip {{choice.calendarMode === 'none' ? 'active' : ''}}" data-id="none" bindtap="calendarMode">不加时令</view><view aria-role="button" hover-class="tap-hover" class="chip {{choice.calendarMode === 'day' ? 'active' : ''}}" data-id="day" bindtap="calendarMode">{{calendar.day}}号 · {{calendar.theme}}</view><view aria-role="button" hover-class="tap-hover" class="chip {{choice.calendarMode === 'season' ? 'active' : ''}}" data-id="season" bindtap="calendarMode">四季</view><view aria-role="button" hover-class="tap-hover" class="chip {{choice.calendarMode === 'term' ? 'active' : ''}}" data-id="term" bindtap="calendarMode">{{calendar.term}}</view></view><view class="reference">{{choice.tone === 'english' ? '英文时令祝愿与正文一同呈现。' : '日期与节气提供意象，不预设此刻的天气。'}}</view></view>
  </view></view>
  <view class="toast-card {{big ? 'big' : ''}}"><view class="card-top"><text class="card-kicker">就说这一句</text><view aria-role="button" hover-class="tap-hover" class="quiet" bindtap="big">{{big ? '收起大字' : '大字读'}}</view></view><view class="toast-title">{{toast.title}}</view><view class="quote-mark">“</view><view class="speech"><text class="speech-line" user-select="{{true}}" wx:for="{{lines}}" wx:key="*this">{{item}}</text></view><view class="translation" wx:if="{{choice.tone === 'english'}}">{{translation}}</view><view class="card-foot"><text>{{kind}}</text><view class="lengths" wx:if="{{choice.tone !== 'english' && hasLengthVariants}}"><view aria-role="button" hover-class="tap-hover" class="chip {{choice.length === 'short' ? 'active' : ''}}" data-id="short" bindtap="length">一句版</view><view aria-role="button" hover-class="tap-hover" class="chip {{choice.length === 'full' ? 'active' : ''}}" data-id="full" bindtap="length">短段版</view></view></view></view>
  <view wx:if="{{revisionAvailable}}" class="revision-notice">这是一条修订前的旧稿。<view aria-role="button" class="link" bindtap="reviewed">查看校订版 ↗</view></view>
  <view class="primary-actions"><view aria-role="button" hover-class="tap-hover" class="primary" bindtap="next">换一句 <text class="next-arrow">↗</text></view><view aria-role="button" hover-class="tap-hover" class="save {{isSaved ? 'saved' : ''}}" bindtap="save">{{isSaved ? '已收藏' : '收进小笺'}}</view></view>
  <view class="notice" role="status" wx:if="{{notice}}">{{notice}}</view>
  <view aria-role="button" class="adapt-button" bindtap="adaptDraft">改成我的话 · 另存编辑</view><view class="secondary-actions"><view aria-role="button" hover-class="tap-hover" class="secondary-button" bindtap="copy">复制这句</view><button size="mini" class="secondary-button" open-type="share"><text class="secondary-label">分享这句</text></button></view>
  <view class="source"><view aria-role="button" hover-class="tap-hover" class="source-toggle" bindtap="details"><view><view class="source-label">这一句，有来头</view><text class="source-subtitle">{{source.title}}</text></view><text class="source-symbol">{{details ? '－' : '＋'}}</text></view><view class="source-body" wx:if="{{details}}"><view class="reference" wx:if="{{source.original}}">本次引用</view><view class="original" wx:if="{{source.original}}">{{source.original}}</view><view class="source-full" wx:if="{{source.fullOriginal}}"><view class="source-label">{{source.fullOriginalLabel}}</view><view class="reference">{{source.fullOriginalTitle || source.title}}</view><text class="full-original-text" user-select="{{true}}">{{source.fullOriginal}}</text><view class="reference">{{source.fullOriginalNote}}</view></view><view>{{source.meaning}}</view><view class="tip">怎么说 · {{toast.tip}}</view><view class="reference">{{source.book}} · {{source.pages}}</view><view class="reference">{{source.note}}</view><view aria-role="button" hover-class="tap-hover" class="link" bindtap="copySource">复制出处</view></view></view>

 </block>
 <view wx:else class="favorites"><view class="section-label">我的小笺</view><view class="tones"><view aria-role="button" class="chip {{savedTab === 'original' ? 'active' : ''}}" data-id="original" bindtap="savedTab">收藏原句 · {{favorites.length}}</view><view aria-role="button" class="chip {{savedTab === 'personal' ? 'active' : ''}}" data-id="personal" bindtap="savedTab">我写的 · {{draftCount}}</view></view><view aria-role="button" class="adapt-button" bindtap="newDraft">＋ 从空白写一张</view><block wx:if="{{savedTab === 'original'}}"><view wx:if="{{!favorites.length}}" class="empty"><view>留一句，待下次。</view><text class="empty-hint">遇到合心意的话，点“收进小笺”。</text><view aria-role="button" hover-class="tap-hover" class="primary" data-id="home" bindtap="tab">去找一句好词</view></view><view wx:for="{{favorites}}" wx:key="query" class="favorite-card"><view aria-role="button" hover-class="tap-hover" class="favorite-open" data-query="{{item.query}}" bindtap="openSaved"><view class="toast-title">{{item.title}}</view><view class="reference">{{item.scene}}</view><view class="excerpt">{{item.excerpt}}</view></view><view aria-role="button" hover-class="tap-hover" class="quiet remove" data-query="{{item.query}}" bindtap="removeSaved">移除</view></view><view class="notice" wx:if="{{notice}}">{{notice}}</view><view class="reference">收藏保存在这台设备。最多保留100张。</view></block><block wx:else><view class="tones"><view aria-role="button" class="chip {{!draftScene ? 'active' : ''}}" data-id="" bindtap="draftScene">全部场景</view><view aria-role="button" class="chip {{draftScene === item ? 'active' : ''}}" wx:for="{{draftScenes}}" wx:key="*this" data-id="{{item}}" bindtap="draftScene">{{item}}</view></view><view class="empty-hint" wx:if="{{!drafts.length}}">这里还没有小笺。可以从空白写，也可以把喜欢的原句另存改写。</view><view class="favorite-card" wx:for="{{drafts}}" wx:key="id"><view aria-role="button" class="favorite-open" data-id="{{item.id}}" bindtap="openDraft"><view class="toast-title">{{item.title}}</view><view class="reference">{{item.scene || '未分类'}} · {{item.target}} · 个人改写</view><view class="excerpt">{{item.text}}</view></view><view class="draft-actions"><view aria-role="button" class="link" data-id="{{item.id}}" bindtap="editDraft">编辑</view><view aria-role="button" class="quiet" data-id="{{item.id}}" bindtap="removeDraft">删除</view></view></view><view class="notice" wx:if="{{notice}}">{{notice}}</view><view class="reference">个人小笺仅保存在本机，最多200张，不提供分享。</view></block></view>
 <view class="footer" wx:if="{{!editor && !personal}}"><text>读诗知意，说话知人。</text><view aria-role="button" hover-class="tap-hover" class="footer-button" bindtap="about">关于小笺与数据说明</view><button size="mini" class="footer-button" open-type="share" data-home="true"><text class="footer-label">把小程序分享给朋友 ↗</text></button></view>
</view>
<view class="bottom-nav"><view aria-role="button" hover-class="tap-hover" class="nav-button {{tab === 'home' ? 'current' : ''}}" data-id="home" bindtap="tab">席间找词</view><view aria-role="button" hover-class="tap-hover" class="nav-button {{tab === 'saved' ? 'current' : ''}}" data-id="saved" bindtap="tab">我的小笺</view></view>

<view wx:if="{{expressionOpen}}" class="expression-layer"><view class="expression-scrim" bindtap="toggleExpression"></view><view class="expression-sheet"><view class="sheet-head"><text>调整表达</text><view aria-role="button" class="sheet-done" bindtap="toggleExpression">完成</view></view>   <view class="selector-label">说话风格</view><view class="tones"><view aria-role="button" wx:for="{{flavorOptions}}" wx:key="id" class="chip {{uiFlavor === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="flavor">{{item.name}}</view></view>
   <view class="selector-label">语言与饮品</view><view class="tones"><view aria-role="button" class="chip {{uiLanguage === 'zh' ? 'active' : ''}}" data-id="zh" bindtap="language">中文</view><view aria-role="button" class="chip {{uiLanguage === 'en' ? 'active' : ''}}" data-id="en" bindtap="language">English</view><view aria-role="button" class="chip {{choice.tea ? 'active' : ''}}" bindtap="tea">{{choice.tea ? '✓ 以茶代酒' : '以茶代酒'}}</view></view>
</view></view>
