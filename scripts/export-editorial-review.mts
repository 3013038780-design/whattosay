s{grid-template-columns:1fr}.stats{gap:20px}h1{font-size:27px}}@media print{.tools,.pagination{display:none}.card{break-inside:avoid}.versions{display:block}.pane{margin:8px 0}}</style><main><div class="eyebrow">席间有话 · 文案审校</div><h1>先读懂原句，再把心意说到人面前。</h1><div class="lead"><p>这份表覆盖修订前的全部580个版本。独立审校逐条读中文长短稿、英文、译意，并对照来源原文；主编辑修订后，再交回审校复读。</p><p>原审结论：308条本轮未见明显问题、67条建议润色、171条需修订、34条历史备查。已经接入261条校订稿、14条来源校正；修订不计作新增素材。</p></div><div class="stats"><div class="stat"><b>580</b>原版本逐条覆盖</div><div class="stat"><b>261</b>已接入校订稿</div><div class="stat"><b>14</b>原文／释义／来源校正</div><div class="stat"><b>0</b>本轮未解决必须修项</div></div><p class="meta">0.6.1 · 2026-10-29 · 默认按原审校顺序，支持搜索正文、作者、出处与问题</p><div class="tools"><input id="search" type="search" placeholder="例如：江声、苏轼、失官、英文、家人" aria-label="搜索审校记录"><select id="filter" aria-label="筛选处理结果"><option value="all">全部580条</option><option value="revised">已校订的261条</option><option value="originalIssues">原审有问题或建议</option><option value="source_corrected">只改来源信息</option><option value="historical">历史／熟句备查</option></select><button id="reset">重置</button></div><div id="count" class="meta"></div><div id="records"></div><div class="pagination"><button id="prev">上一页</button><span id="page"></span><button id="next">下一页</button></div><p class="boundary">${data.limits}</p><p class="meta">旧分享保留原文，界面可点“查看校订版”。诗词全文保留；不合当前发言身份的引句，不强行塞进该场景。<a href="verification/editorial-review.json">下载全部对照数据</a></p></main><script>const D=${payload};const el=id=>document.getElementById(id);const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let page=0;const size=20;const status={no_obvious_issue:'本轮未见明显问题',polish:'建议润色',needs_revision:'需要修订',historical_only:'历史备查'};const result={revised:'已校订',source_corrected:'来源已校正',historical:'历史留档',retained:'保留表达'};const pane=(t,label,cls)=>t?'<div class="pane '+cls+'"><div class="label">'+label+' · v'+t.version+'</div><h3>'+esc(t.title)+'</h3><div class="speech">'+esc(t.short)+'</div><details><summary>短段版、英文与译意</summary><div class="speech">'+esc(t.full)+'</div><p>'+esc(t.english)+'</p><p class="meta">'+esc(t.translation)+'</p></details></div>':'<div class="pane"><p>此历史稿不参与推荐，保留原文供查阅。</p></div>';function render(){const q=el('search').value.trim().toLowerCase(),f=el('filter').value;const rows=D.records.filter(r=>(f==='all'||f==='originalIssues'&&r.active&&r.findings.length||r.resolution===f)&&(!q||JSON.stringify([r.id,r.before,r.after,r.findings,D.sources[r.after?.source||r.before.source]]).toLowerCase().includes(q)));const pages=Math.max(1,Math.ceil(rows.length/size));page=Math.min(page,pages-1);el('count').textContent='匹配 '+rows.length+' / 580 个原版本';el('records').innerHTML=rows.slice(page*size,(page+1)*size).map(r=>{const s=D.sources[r.after?.source||r.before.source];return '<article class="card"><div><span class="badge '+(r.resolution==='revised'?'changed':'')+'">'+result[r.resolution]+'</span><span class="badge">原审：'+(status[r.status]||r.status)+'</span></div><p class="meta">'+esc(r.id)+' · 原v'+r.version+' · '+esc(r.before.scene)+' / '+esc(r.before.target)+'</p>'+(r.findings.length?'<ul class="issues">'+r.findings.map(i=>'<li>'+esc(i.problem)+'</li>').join('')+'</ul>':'<p class="meta">原审未记录明显问题。</p>')+'<p class="reason">处理：'+esc(r.resolutionNote)+'</p><div class="versions">'+pane(r.before,'原稿','')+pane(r.after,'当前稿','new')+'</div><details><summary>当前所用出处与完整原文</summary><h3>'+esc(s.title)+'</h3><p class="quote">'+esc(s.original||'表达方法，无古诗引句')+'</p><pre>'+esc(s.fullOriginal||'此来源为表达方法，不冒充古人原文。')+'</pre><p>'+esc(s.meaning)+'</p><p class="meta">'+esc(s.book)+' · '+esc(s.pages)+'</p><p class="meta">'+esc(s.note)+'</p>'+((s.fullOriginalUrl||s.url)?'<a target="_blank" rel="noopener" href="'+esc(s.fullOriginalUrl||s.url)+'">查看来源</a>':'')+'</details></article>';}).join('');el('page').textContent=(page+1)+' / '+pages;el('prev').disabled=page===0;el('next').disabled=page>=pages-1;}el('search').oninput=el('filter').onchange=()=>{page=0;render()};el('reset').onclick=()=>{el('search').value='';el('filter').value='all';page=0;render()};el('prev').onclick=()=>{page--;render();el('records').scrollIntoView()};el('next').onclick=()=>{page++;render();el('records').scrollIntoView()};render();</script></html>`;
