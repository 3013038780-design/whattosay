import {editorialRevisions,editorialSourcePatches} from '../src/data/editorial-revisions';
import {writeFile,mkdir,readFile} from 'node:fs/promises';
import {createHash} from 'node:crypto';
import {toasts} from '../src/data/toasts';
import {sources} from '../src/data/sources';
import {collectedSources,collectedToasts} from '../src/data/poetry-expanded';
import {readingSources,readingToasts} from '../src/data/reading-batch';
import {contextualToasts} from '../src/data/contextual';
import {choiceLabel} from '../src/core/context';
import {sceneOptions} from '../src/core/engine';

// A review export of shipped content, not an expansion of the source corpus.
const date='2026-10-29';
const poetryIds=new Set(['reunion','autumn','luming','lumingGuest','longevity','bode','gaoshi','zhang','reciprocate']);
const priority=(t:typeof toasts[number])=>t.source in readingSources?0:t.source in collectedSources?1:t.active!==false?1:t.archiveReason==='common'?2:3;
const quoted=toasts.filter(t=>t.kind==='引句后整理').sort((a,b)=>priority(a)-priority(b));
const active=quoted.filter(t=>t.active!==false),archived=quoted.filter(t=>t.active===false);
const groups=new Map<string,typeof quoted>();
for(const t of quoted){const key=t.source==='lumingGuest'?'luming':t.source;groups.set(key,[...(groups.get(key)||[]),t]);}
const named:Record<string,string>={reunion:'孟浩然《过故人庄》',lantingMeet:'王羲之《兰亭集序》：欣于所遇'};
const scene=(id:string)=>sceneOptions.find(s=>s.id===id)?.name||id;
const topicNames:Record<string,string>={any:'随席取意',night:'夜晚',moon:'月色',wine:'邀饮待客',friend:'好友知己',reunion:'团圆相聚'};
const festivalNames:Record<string,string>={midautumn:'中秋',lantern:'元宵',doubleNinth:'重阳',newyear:'春节'};
const targets:Record<string,string>={table:'全桌',leader:'领导',elder:'长辈',host:'主人',person:'单独一位'};
const esc=(v:unknown)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
const activeTotal=toasts.filter(t=>t.active!==false).length;
const form=(key:string)=>sources[key].form||(poetryIds.has(key)?'古诗':'古文／语录');
const poetic=(key:string)=>form(key)!=='古文／语录';
const status=(t:typeof toasts[number])=>t.archiveReason==='common'?'常见句备查，不参与推荐':t.active===false?'历史版本，仅供原分享恢复':t.editorialNote?'0.6.1校订 · 当前推荐':t.id.startsWith('c06-')?'0.6新增 · 当前推荐':t.source in readingSources?'0.4新增 · 当前推荐':t.source in collectedSources?'0.3新增 · 当前推荐':'当前推荐';
const poemEntries=active.filter(t=>poetic(t.source)).length;
const percent=(n:number)=>(100*n/activeTotal).toFixed(1)+'%';
const sourceFiles=['src/data/toasts.ts','src/data/spoken.ts','src/data/cultural.ts','src/data/full-originals.ts','src/data/reading-batch.ts','src/data/contextual.ts','src/data/expansion-06.ts','src/data/editorial-revisions.ts','src/data/sources.ts','src/data/sources-expanded.ts','src/data/poetry-expanded.ts'];
const hash=createHash('sha256');for(const p of sourceFiles)hash.update(p).update(await readFile(p));
const quoteKey=(value:string)=>value.replace(/[\s，。！？；、：,.!?;:]/g,'');
const excerpts=(key:string)=>sources[key].excerpts||(key==='practice'?['见贤思齐焉。','君子欲讷于言而敏于行。']:[sources[key].original||'']);
const distinct=(keys:string[])=>new Set(keys.flatMap(excerpts).map(quoteKey)).size;
const activeKeys=[...new Set(active.map(t=>t.source==='lumingGuest'?'luming':t.source))];
const distinctPoetryExcerpts=distinct(activeKeys.filter(poetic));
const distinctProseExcerpts=distinct(activeKeys.filter(key=>!poetic(key)));
const stats={date,version:'0.6.1',activeTotal,activeQuotedEntries:active.length,activePoetryEntries:poemEntries,activeProseEntries:active.length-poemEntries,activeDistinctPoeticExcerpts:distinctPoetryExcerpts,activeDistinctProseExcerpts:distinctProseExcerpts,totalDistinctExcerptsIncludingReserved:distinct([...groups.keys()]),newExcerpts:0,newWorks:0,newDrafts:0,revisedDrafts:Object.keys(editorialRevisions).length,sourceCorrections:Object.keys(editorialSourcePatches).length,modernExcerpts:distinct(activeKeys.filter(key=>form(key)==='现代诗')),commonReservedVersions:quoted.filter(t=>t.archiveReason==='common').length,historicalVersions:quoted.filter(t=>t.active===false&&!t.archiveReason).length,sourceSHA256:hash.digest('hex')};
const snapshot={stats,scope:'当前程序中全部古诗文引用文案及其历史版本；不代表所供十份PDF的全部诗句。',entries:quoted.map(t=>({...t,status:status(t),category:form(t.source),sourceDetails:sources[t.source]}))};
const intro=`截至${date}：当前推荐${activeTotal}条，含古诗文引用稿${active.length}条（${percent(active.length)}）；其中古诗／词／现代诗引用稿${poemEntries}条，古文／语录引用稿${active.length-poemEntries}条。当前不同诗词引句${distinctPoetryExcerpts}处、古文引句${distinctProseExcerpts}处；连同常见句备查与历史记录，库内共${stats.totalDistinctExcerptsIncludingReserved}处不同引句。本轮校订${stats.revisedDrafts}条稿件，修正${stats.sourceCorrections}条原文／释义／来源信息；修订不计作新增素材。现代诗目前仅徐志摩《偶然》1处引句，尚待继续扩充。`;
const boundary='古人原句与后续整理的祝酒词分开列示。每条附出处、原意、适合场景和必要的字词提示；所供书籍与自主补充来源分别标注。';
const rows=[...groups].map(([key,entries])=>{const s=sources[key],count=entries.filter(t=>t.active!==false).length;return `<tr><td><a href="#source-${key}">${esc(named[key]||s.title)}</a></td><td>${esc(s.original)}</td><td>${form(key)}</td><td>${count}</td></tr>`;}).join('');
let seq=0;
const sections=[...groups].map(([key,entries])=>{const s=sources[key];return `<section id="source-${key}"><h2>${esc(named[key]||s.title)}</h2><p class="meta">本次引用</p><blockquote>${esc(s.original)}</blockquote>${s.fullOriginal?`<h3>${esc(s.fullOriginalLabel)}</h3><p style="white-space:pre-wrap">${esc(s.fullOriginal)}</p><p class="meta">${esc(s.fullOriginalNote)}</p>`:''}<p class="meta">${form(key)} · ${entries.filter(t=>t.active!==false).length}条当前推荐</p><p>${esc(s.meaning)}</p><p class="meta">语料线索：${esc(s.book)} · ${esc(s.pages)}</p><p class="meta">${esc(s.note)} ${s.url?`<a href="${esc(s.url)}" target="_blank" rel="noopener noreferrer">原作／核对来源</a>`:''}</p>${entries.map(t=>{seq++;const ts=sources[t.source];return `<article data-entry data-status="${t.active===false?'archived':'active'}"><h3>${seq}. ${esc(t.title)} <span class="badge">${status(t)}</span></h3><p class="meta">${esc(t.occasions?t.occasions.map(o=>choiceLabel({occasion:o,purpose:t.purpose} as any)).join('、'):scene(t.scene))} · ${esc(targets[t.target])} · ${esc(t.id)} @${t.version}${t.seasons?' · 仅限'+esc(t.seasons.join('、'))+'季':''}${t.topics?' · 意境：'+esc(t.topics.map(id=>topicNames[id]).join('、')):''}${t.festivals?' · 节日限定：'+esc(t.festivals.map(id=>festivalNames[id]).join('、')):''}</p><h4>一句版 · 独立整理</h4><p>${esc(t.short)}</p><h4>短段版 · 独立整理</h4><p>${esc(t.full)}</p><details><summary>英文、场合提示及该条来源说明</summary><p lang="en">${esc(t.english)}</p><p>${esc(t.translation)}</p><p>怎么说：${esc(t.tip)}</p><p>引文说明：${esc(ts.meaning)}</p><p>核对记录：${esc(ts.note)}</p><p>茶饮收尾：${esc(t.teaLine||'今天以茶代酒，心意一样真。')}</p></details></article>`;}).join('')}</section>`;}).join('');
const html=`<!doctype html><html lang="zh-CN"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>席间有话 · 全部诗文引用库</title><style>body{margin:0;background:#f7f3eb;color:#263d33;font:17px/1.85 -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}main{max-width:1000px;margin:auto;padding:36px 24px 80px;overflow-wrap:anywhere}h1,h2,h3,blockquote{font-family:"Songti SC",serif}h1{font-size:34px;line-height:1.4}h2{margin-top:42px}h3{font-size:21px}h4{font-size:15px;color:#865442;margin:20px 0 4px}p{margin:8px 0}.lead{background:#e8eadf;border-left:4px solid #536b53;padding:18px 22px}.meta{font-size:14px;color:#667263}a{color:#8b4233}table{border-collapse:collapse;width:100%;font-size:15px}td,th{text-align:left;vertical-align:top;border-bottom:1px solid #d9d2c4;padding:12px 8px}blockquote{margin:18px 0;border-left:3px solid #a94334;padding:12px 22px;background:#fffdf7;font-size:23px}article{padding:14px 24px 24px;margin:20px 0;border:1px solid #dcd5c7;background:#fffdf7;border-radius:6px}article[data-status=archived]{background:#efeee8}.badge{font:12px sans-serif;padding:4px 6px;background:#e8eadf;white-space:nowrap}.tools{position:sticky;top:0;background:#f7f3ebed;padding:12px 0;display:flex;gap:12px;flex-wrap:wrap}input{font:inherit;padding:10px;width:min(100%,550px);box-sizing:border-box;border:1px solid #a5afa0;border-radius:4px}button{font:inherit;padding:8px 14px;background:#374e43;color:white;border:0;border-radius:4px;cursor:pointer}summary{cursor:pointer;color:#7c4e3d;margin-top:20px}[hidden]{display:none!important}.table-wrap{overflow:auto}footer{border-top:1px solid #ccc;padding-top:24px;margin-top:40px;font-size:13px;color:#667263}@media(max-width:600px){main{padding:24px 16px}h1{font-size:28px}article{padding:12px 16px}td,th{min-width:72px}td:nth-child(2){min-width:160px}}@media print{.tools{display:none}body{background:white;color:black}main{max-width:none;padding:0}article{break-inside:avoid}details{display:block}a{color:black}}</style><main><h1>席间有话 · 全部诗文引用库</h1><p class="meta">程序版本0.6.1 · 导出日期${date} · 供逐条审阅</p><div class="lead"><p>${intro}</p><p>“古诗文引用文案数”与“不同古诗句数”采用不同口径，不能混为一谈。</p></div><p>${boundary}</p><p>本页展示全部${quoted.length}个引用版本的中文正文，不因搜索或折叠默认隐藏任何正文。诗词句后的祝愿并非古人原文。程序的通用举杯收尾与日期句由用户选择组合，以下列内容库正文。</p><div class="tools"><input id="search" type="search" placeholder="搜索原句、场景、作者、关键词" aria-label="搜索诗文库"><button id="reset">显示全部</button><button id="expand">展开全部说明</button><button id="print">打印／保存PDF</button><span id="count">全部${quoted.length}个版本</span></div><h2>全部原句与复用情况</h2><p>同一作品的不同引句各自列出；同一句的场景改写不增加引句数。“我有嘉宾”主人／来宾合并统计，旧《论语·里仁》来源含两处引句。标记“常见句备查”的30条已退出推荐，仍完整保留。</p><div class="table-wrap"><table><thead><tr><th>出处</th><th>原句</th><th>类别</th><th>推荐稿数</th></tr></thead><tbody>${rows}</tbody></table></div>${sections}<footer><p>完整机器可读副本：<a href="poetry-library.json">JSON</a>；便于批注的<a href="poetry-library.txt">纯文本</a>。</p><p>歇后语与原创押韵稿没有计为古诗；所供PDF全文及OCR不包含在此导出中。</p><p>源文件指纹 SHA-256：${stats.sourceSHA256}</p></footer></main><script>const search=document.querySelector('#search');const sections=[...document.querySelectorAll('section')];function filter(){let shown=0;const q=search.value.trim().toLowerCase();for(const section of sections){let visible=0;const header=[...section.children].filter(e=>e.tagName!=='ARTICLE').map(e=>e.textContent).join(' ').toLowerCase();for(const article of section.querySelectorAll('[data-entry]')){const match=!q||header.includes(q)||article.textContent.toLowerCase().includes(q);article.hidden=!match;if(match)visible++;}section.hidden=!visible;shown+=visible;}document.querySelector('#count').textContent='显示'+shown+'／${quoted.length}个版本';}search.addEventListener('input',filter);document.querySelector('#reset').onclick=()=>{search.value='';filter();};document.querySelector('#expand').onclick=()=>{document.querySelectorAll('details').forEach(d=>d.open=true);};document.querySelector('#print').onclick=()=>{document.querySelectorAll('details').forEach(d=>d.open=true);window.print();};</script></html>`;
let text=`席间有话 · 全部诗文引用库\n版本0.6.1 · ${date}\n\n${intro}\n\n${boundary}\n\n`;
let n=0;for(const [key,entries] of groups){const s=sources[key];text+=`\n========== ${named[key]||s.title} ==========\n原句：${s.original}\n${s.fullOriginalLabel||'原作'}：\n${s.fullOriginal||''}\n全文核对：${s.fullOriginalNote||''}\n类别：${form(key)}\n语料线索：${s.book} · ${s.pages}\n含义：${s.meaning}\n核对记录：${s.note}\n原作：${s.url}\n`;for(const t of entries){n++;text+=`\n${n}. ${t.title}\n状态：${status(t)}\n编号：${t.id} @${t.version}\n场景：${scene(t.scene)}／${targets[t.target]}${t.seasons?'；仅限'+t.seasons.join('、')+'季':''}${t.topics?'；意境：'+t.topics.map(id=>topicNames[id]).join('、'):''}${t.festivals?'；节日限定：'+t.festivals.map(id=>festivalNames[id]).join('、'):''}\n一句版（整理）：${t.short}\n短段版（整理）：${t.full}\n英文：${t.english}\n中文释意：${t.translation}\n怎么说：${t.tip}\n该条来源说明：${sources[t.source].meaning}\n审阅意见：\n保留／修改／不合适：\n`;}}
await mkdir('docs',{recursive:true});await writeFile('docs/poetry-library.html',html);await writeFile('docs/poetry-library.txt',text);await writeFile('docs/poetry-library.json',JSON.stringify(snapshot,null,2)+'\n');
// Keep the existing local product preview intact; add a separate review page.
await mkdir('dist/preview/library',{recursive:true});for(const ext of ['html','txt','json'])await writeFile(`dist/preview/library/poetry-library.${ext}`,ext==='html'?html:ext==='txt'?text:JSON.stringify(snapshot,null,2)+'\n');
console.log(JSON.stringify(stats,null,2));console.log('Exported 3 review files into docs/ and dist/preview/library/.');
